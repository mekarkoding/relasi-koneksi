# STRICT RULE: Portable Text Rendering

Article bodies are stored as **Portable Text, NOT HTML and NOT Markdown**. Never treat the body as a string.

## Required Implementation

```tsx
import { PortableText, PortableTextComponents } from '@portabletext/react'
import Image from 'next/image'
import { urlForImage } from '@/lib/sanity/image'

const portableTextComponents: PortableTextComponents = {
  // Block styles
  block: {
    h2: ({ children }) => <h2 className="text-2xl font-bold mt-8 mb-4">{children}</h2>,
    h3: ({ children }) => <h3 className="text-xl font-semibold mt-6 mb-3">{children}</h3>,
    normal: ({ children }) => <p className="mb-4 leading-relaxed">{children}</p>,
    blockquote: ({ children }) => (
      <blockquote className="border-l-4 border-gray-300 pl-4 italic my-4">
        {children}
      </blockquote>
    ),
  },

  // Marks (inline styles)
  marks: {
    strong: ({ children }) => <strong className="font-bold">{children}</strong>,
    em: ({ children }) => <em className="italic">{children}</em>,
    link: ({ value, children }) => (
      <a 
        href={value?.href} 
        target="_blank" 
        rel="noopener noreferrer"
        className="text-blue-600 underline hover:text-blue-800"
      >
        {children}
      </a>
    ),
  },

  // Lists
  list: {
    bullet: ({ children }) => <ul className="list-disc pl-6 mb-4 space-y-2">{children}</ul>,
    number: ({ children }) => <ol className="list-decimal pl-6 mb-4 space-y-2">{children}</ol>,
  },
  listItem: {
    bullet: ({ children }) => <li>{children}</li>,
    number: ({ children }) => <li>{children}</li>,
  },

  // Custom types
  types: {
    // Inline image - MUST use next/image + Sanity CDN
    image: ({ value }) => {
      if (!value?.asset) return null
      return (
        <figure className="my-6">
          <Image
            src={urlForImage(value).width(800).url()}
            alt={value.alt || ''}
            width={800}
            height={600}
            className="rounded-lg"
            sizes="(max-width: 768px) 100vw, 800px"
          />
          {value.caption && (
            <figcaption className="text-sm text-gray-600 mt-2 text-center">
              {value.caption}
            </figcaption>
          )}
        </figure>
      )
    },

    // YouTube embed - MUST be lazy-loaded
    youtube: ({ value }) => {
      if (!value?.url) return null
      const videoId = extractYouTubeId(value.url)
      if (!videoId) return null
      
      return (
        <div className="my-6 aspect-video">
          <LazyYouTubeEmbed videoId={videoId} />
        </div>
      )
    },
  },
}

// Usage in component
export function ArticleBody({ body }: { body: PortableTextBlock[] }) {
  return (
    <article className="prose max-w-none">
      <PortableText value={body} components={portableTextComponents} />
    </article>
  )
}
```

## FORBIDDEN Patterns

```tsx
// ❌ FORBIDDEN - dangerouslySetInnerHTML for article content
<div dangerouslySetInnerHTML={{ __html: article.body }} />

// ❌ FORBIDDEN - Treating body as string
<p>{article.body}</p>

// ❌ FORBIDDEN - Markdown rendering
import ReactMarkdown from 'react-markdown'
<ReactMarkdown>{article.body}</ReactMarkdown>

// ❌ FORBIDDEN - Plain img in image type
types: {
  image: ({ value }) => <img src={value.url} alt={value.alt} />  // NO!
}
```

## Required Components Map Coverage

| Element | Required | Notes |
|---------|----------|-------|
| h2, h3 | ✅ | Block styles |
| normal | ✅ | Paragraph |
| blockquote | ✅ | Quote blocks |
| strong, em | ✅ | Bold, italic marks |
| link | ✅ | Must have `target="_blank"` and `rel="noopener noreferrer"` |
| bullet, number lists | ✅ | List types |
| image | ✅ | Via next/image + Sanity CDN with caption/alt |
| youtube | ✅ | Lazy-loaded embed |

## Unknown Block Types

Unknown block types must render nothing and log a console warning in development - **never crash the page**.

```tsx
// Handle unknown types gracefully
types: {
  // ... known types ...
  default: ({ value }) => {
    if (process.env.NODE_ENV === 'development') {
      console.warn(`Unknown Portable Text type: ${value._type}`)
    }
    return null
  },
}
```
