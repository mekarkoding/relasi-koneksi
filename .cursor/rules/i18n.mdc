## Usage in Components

```tsx
import { useTranslations } from 'next-intl'

export function HomestayCard({ homestay }: { homestay: Homestay }) {
  const t = useTranslations('homestay')
  const locale = useLocale()
  
  // ❌ BAD - Hardcoded string
  return <button>Contact via WhatsApp</button>
  
  // ✅ GOOD - Translated string
  return <button>{t('contactWhatsApp')}</button>
}
```

## Article Fallback Rule

If an article's English content (`title_en`, `body_en`) is empty:
- Show Indonesian content
- Display a note: "Available in Indonesian only" / "Tersedia dalam Bahasa Indonesia saja"
- **Never show a broken/blank page**

```tsx
function getArticleContent(article: Article, locale: Locale) {
  const hasEnglish = locale === 'en' && article.title_en && article.body_en
  
  return {
    title: hasEnglish ? article.title_en : article.title_id,
    body: hasEnglish ? article.body_en : article.body_id,
    showFallbackNote: locale === 'en' && !hasEnglish,
  }
}
```

## SEO Requirements

Each page must emit correct `hreflang` alternates:

```tsx
// In page metadata
export function generateMetadata({ params }: Props): Metadata {
  return {
    alternates: {
      languages: {
        'id': `/id${path}`,
        'en': `/en${path}`,
      },
    },
  }
}
```

## Language Switcher

- Visible on every page in top navigation
- Displays as "ID | EN" toggle
- Switching preserves current page path
